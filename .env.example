# Chave secreta para sessões Flask
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere-uma-chave-segura-com-o-comando-acima

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_db
DB_USER=seu_usuario_db
DB_PASS=sua_senha_db

# Configurações SMTP
SMTP_SERVER=smtplw.com.br
SMTP_PORT=587
SMTP_USER=seu_usuario_smtp
SMTP_PASSWORD=sua_senha_smtp
SMTP_SENDER_EMAIL=contato@seudominio.com.br
SMTP_DEFAULT_RECIPIENT=destinatario@seudominio.com.br

# URL pública da aplicação (sem barra no final)
APP_BASE_URL=http://seu-dominio.com.br:5002

# Senha do usuário admin criado na primeira execução
ADMIN_INITIAL_PASSWORD=defina-uma-senha-forte-aqui

# Modo debug (nunca use true em produção)
DEBUG=false

# Porta do servidor (padrão: 5002)
PORT=5002
